{
  "manifest_version": 3,
  "name": "Leetmate",
  "version": "1.0",
  "description": "A browser extension that keeps you accountable on LeetCode with a virtual pet companion.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon16.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "notifications", "alarms"]
}
