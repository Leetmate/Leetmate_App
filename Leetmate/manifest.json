{
  "manifest_version": 3,
  "name": "Leetmate",
  "version": "1.0",
  "description": "A browser extension that keeps you accountable on LeetCode with a virtual pet companion.",
  "icons": {
    "16": "assets/LeetMate_icons/icon16.png",
    "48": "assets/LeetMate_icons/icon48.png",
    "128": "assets/LeetMate_icons/icon128.png"
  },
  "action": {
    "default_icon": "assets/LeetMate_icons/icon16.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "notifications", "alarms", "tabs", "cookies", "webNavigation"],
  "host_permissions": ["<all_urls>", "https://leetcode.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
  //make a module for add pet like background.js here
}
