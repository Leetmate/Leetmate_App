{
  "manifest_version": 3,
  "name": "Leetmate",
  "version": "1.0",
  "description": "A browser extension that keeps you accountable on LeetCode with a virtual pet companion.",
  "icons": {
    "16": "assets/LeetMate_icons/icon16.png",
    "48": "assets/LeetMate_icons/icon48.png",
    "128": "assets/LeetMate_icons/icon128.png"
  },
  "action": {
    "default_icon": "assets/LeetMate_icons/icon16.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcodeContent.js", "js/storageHelper.js"]
    }
  ],
  "permissions": ["storage", "notifications", "alarms", "tabs", "cookies", "webNavigation", "scripting"],
	"web_accessible_resources": [
		{
			"resources": [
				"assets/bg_home.png",
				"assets/Animals - Outline/*.png"
			],
			"matches": ["<all_urls>"]
		}
	],
  "host_permissions": ["<all_urls>", "https://leetcode.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
